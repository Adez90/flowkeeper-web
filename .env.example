# Copy to .env.local for local dev overrides. Both have sensible localhost
# defaults baked into src/auth/oidcConfig.ts and src/api/client.ts, so this
# file only needs filling in once these move off localhost.

VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_AUTHORITY=http://localhost:8081/realms/flowkeeper
VITE_KEYCLOAK_CLIENT_ID=flowkeeper-web
