# Copy to .env.local for local dev overrides. Both have sensible localhost
# defaults baked into src/auth/oidcConfig.ts and src/api/client.ts, so this
# file only needs filling in once these move off localhost.

VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_AUTHORITY=http://localhost:8082/realms/flowkeeper
VITE_KEYCLOAK_CLIENT_ID=flowkeeper-web

# --- Error tracking (optional) ---
# Blank means Sentry is never initialized — no errors leave the browser.
# A Sentry DSN is designed to be public (it's write-only, safe in a
# client bundle), so this is fine to set directly in the build pipeline
# rather than treating it as a secret.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
